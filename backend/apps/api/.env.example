OPENAI_API_KEY=replace-with-your-key
OPENAI_MODEL=gpt-4.1
OPENAI_BASE_URL=
LLM_PROVIDER=openai
APP_ENV=dev
# Gates the /ops/worker/* and /ops/scheduler/* control-plane routes. Keep false in prod.
ENABLE_WORKER_ROUTES=true
ENABLE_DEV_AUTH_ROUTES=true
DISABLE_DEV_AUTH_ROUTES_IN_PROD=true
AUTH_MODE=bearer_only
IAM_USE_DB_AUTH=true
IAM_SKIP_MFA_IN_DEV=true
ALLOW_PASSWORD_AUTH_IN_PROD=false
WEBAUTHN_ENABLED=false
WEBAUTHN_ORIGIN=http://localhost:3000
WEBAUTHN_RP_ID=localhost
AUTH_COOKIE_SECURE=false
SSE_TOKEN_TTL_SECONDS=300
API_KEY_PEPPER=
REDIS_REQUIRE_TLS=false
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_SECURE=true
DOCUMENTS_BUCKET_PREFIX=finance-docs
DOCUMENT_CONFIDENCE_THRESHOLD=0.85
DOCUMENT_RETENTION_YEARS=8
CLAMAV_ENABLED=false
CLAMAV_MODE=exec
CLAMAV_EXECUTABLE=clamscan
CLAMAV_CLAMD_HOST=127.0.0.1
CLAMAV_CLAMD_PORT=3310

OCR_PROVIDER=auto
OCR_HYBRID_VALIDATE=true

# AWS (EC2: use IAM instance profile — leave ACCESS_KEY empty)
STORAGE_PROVIDER=auto
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
DOCUMENTS_S3_BUCKET=
TEXTRACT_S3_BUCKET=

GCP_PROJECT_ID=
GCP_LOCATION=us
GCP_DOCUMENTAI_PROCESSOR_ID=
GCP_CREDENTIALS_JSON=

# Module 7 - Integrations
INTEGRATIONS_CREDENTIALS_KEY=
INTEGRATIONS_API_KEY_RATE_LIMIT_PER_MINUTE=120
IAM_ACCESS_TOKEN_TTL_SECONDS=900
IAM_REFRESH_TOKEN_TTL_SECONDS=604800
JWT_REQUIRE_JWKS_IN_PROD=true
JWT_JWKS_URL=
OIDC_ENABLED=false
OIDC_PROVIDER=auth0
OIDC_AUTHORIZATION_ENDPOINT=
OIDC_TOKEN_ENDPOINT=
OIDC_ISSUER=
OIDC_JWKS_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=
OIDC_SCOPES=openid profile email
OIDC_USE_PKCE=true
OIDC_STATE_TTL_SECONDS=600
OIDC_ORG_CLAIM=org_id
OIDC_ROLES_CLAIM=roles
OIDC_USER_CLAIM=sub
API_SESSION_TTL_SECONDS=3600
OIDC_REFRESH_TTL_SECONDS=86400
OIDC_STORE_PREFIX=oidc
LLM_TIMEOUT_SECONDS=20
LLM_MAX_RETRIES=3
LLM_RETRY_BASE_MS=300
LLM_CIRCUIT_FAIL_THRESHOLD=5
LLM_CIRCUIT_OPEN_SECONDS=60
LLM_TOKENS_PER_MINUTE_PER_ORG=30000
# Billing resilience for AI (Phase 5 / Wave 3 INT-21)
# If true, unexpected billing subsystem failures won't block AI operations.
# Quota/credits/entitlement denials still fail closed.
BILLING_FAIL_OPEN_AI=false
# Cloud Postgres (Neon) — enable pgvector in Neon dashboard (Extensions → vector) before migrations.
# Use the *pooler* host for app traffic; run migrations with the same DSN or direct (non-pooler) host.
# Example:
# POSTGRES_DSN=postgresql://user:pass@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require
POSTGRES_DSN=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require
# Co-locate API, Neon Postgres, and Redis in the same AWS region to avoid 150–400ms cross-region hops.
POSTGRES_POOL_MIN=5
POSTGRES_POOL_MAX=20
POSTGRES_REQUIRE_TLS=true
DEV_USE_POSTGRES=true
# Redis Cloud (ap-south-1) — use password from Redis Cloud console
# REDIS_URL=redis://default:PASSWORD@redis-16427.c305.ap-south-1-1.ec2.cloud.redislabs.com:16427
# Max connections borrowed from the shared pool (default 20). All app code uses app.services.redis_client.
REDIS_POOL_MAX_CONNECTIONS=20
REDIS_URL=
QUEUE_INGESTION_SYNC=ingestion.sync
QUEUE_INGESTION_RETRY=ingestion.retry
QUEUE_PROCESSING_CHUNK=processing.chunk
QUEUE_PROCESSING_EMBED=processing.embed
QUEUE_PROCESSING_EXTRACT=processing.extract
QUEUE_GRAPH_UPSERT=graph.upsert
QUEUE_MEMORY_WRITE=memory.write
QUEUE_RETRIEVAL_PRECOMPUTE=retrieval.precompute
QUEUE_AGENT_RUN=agent.run
QUEUE_AGENT_ACTION=agent.action
QUEUE_NOTIFICATIONS_DISPATCH=notifications.dispatch
QUEUE_NOTIFICATIONS_EMAIL=notifications.email
QUEUE_NOTIFICATIONS_WHATSAPP=notifications.whatsapp
QUEUE_NOTIFICATIONS_PUSH=notifications.push
RESEND_API_KEY=
RESEND_FROM_EMAIL=onboarding@resend.dev
NOTIFICATION_RETRY_MAX_ATTEMPTS=5
NOTIFICATION_RETRY_BASE_SECONDS=5
WHATSAPP_API_URL=
WHATSAPP_API_TOKEN=
SMS_API_URL=
SMS_API_TOKEN=
PUSH_API_URL=
TEAMS_WEBHOOK_URL=
QUEUE_AUDIT_PERSIST=audit.persist
INTEGRATION_TIMEOUT_SECONDS=10
INTEGRATION_MAX_RETRIES=3
SLACK_WEBHOOK_URL=
ERP_WEBHOOK_URL=
BANK_WEBHOOK_URL=
CRM_WEBHOOK_URL=
DOCS_WEBHOOK_URL=
TICKETING_WEBHOOK_URL=
JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=
LINEAR_API_KEY=
LINEAR_TEAM_ID=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
OTEL_ENABLED=false
OTEL_SERVICE_NAME=company-brain-api
OTEL_EXPORTER_OTLP_ENDPOINT=
OBSERVABILITY_REQUIRE_IN_PROD=true
LOG_SINK_URL=
LOG_LEVEL=INFO

# Integrations mode: auto | stub | production
# production requires GSTN/NSDL/BANK credentials (see security_validation.py)
# INTEGRATIONS_MODE=auto

# GST government connectors (required when INTEGRATIONS_MODE=production)
# GST_CONNECTOR_PROVIDER=auto
# GSTN_BASE_URL=
# GSTN_USERNAME=
# GSTN_PASSWORD=
# GSTN_API_KEY=
# IRP_BASE_URL=
# IRP_CLIENT_ID=
# IRP_CLIENT_SECRET=
# EWAY_BASE_URL=
# EWAY_USERNAME=
# EWAY_PASSWORD=

# TDS/NSDL filing connectors (required when INTEGRATIONS_MODE=production)
# TDS_CONNECTOR_PROVIDER=auto
# NSDL_TDS_BASE_URL=
# NSDL_TDS_TAN=
# NSDL_TDS_USER=
# NSDL_TDS_PASSWORD=

# Bank API connector (required when INTEGRATIONS_MODE=production)
# BANK_API_BASE_URL=
# BANK_API_KEY=
# BANK_CLIENT_ID=

# Phase 1 Wave 2 — event platform / outbox
EVENT_OUTBOX_DUAL_WRITE=false
OUTBOX_MAX_ATTEMPTS=10
EVENT_REQUIRE_REGISTERED_FINANCIAL=true
EVENT_FINANCIAL_EMIT_FAIL_OPEN=true
OUTBOX_ARCHIVE_AFTER_DAYS=90
