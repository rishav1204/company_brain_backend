# Non-secret production overrides (optional). Secrets go in Secrets Manager.
APP_ENV=prod
STORAGE_PROVIDER=s3
AWS_REGION=ap-south-1
DOCUMENTS_S3_BUCKET=company-brain-docs-prod
TEXTRACT_S3_BUCKET=company-brain-textract-prod
OCR_PROVIDER=aws_textract
DOCUMENTS_BUCKET_PREFIX=finance-docs
POSTGRES_REQUIRE_TLS=true
REDIS_REQUIRE_TLS=false
ENABLE_DEV_AUTH_ROUTES=false
DISABLE_DEV_AUTH_ROUTES_IN_PROD=true
OBSERVABILITY_REQUIRE_IN_PROD=true
OIDC_ENABLED=true
OIDC_PROVIDER=generic
OIDC_SCOPES=openid profile email
OIDC_USE_PKCE=true
OIDC_ALLOWED_REDIRECT_URIS=
OIDC_ORG_CLAIM=org_id
OIDC_USER_CLAIM=sub
OIDC_ROLES_CLAIM=roles
OTEL_ENABLED=true
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318/v1/traces
LOG_SINK_URL=
ALLOW_PASSWORD_AUTH_IN_PROD=true
AUTH_MODE=bearer_only
IAM_USE_DB_AUTH=true
